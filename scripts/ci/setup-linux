#!/usr/bin/env bash
set -euo pipefail

# usage: setup-linux SETUP [PACKAGE...]
# SETUP is the proof's display substrate; PACKAGEs are the Debian packages the
# proof declares in its contract.
setup=${1-}
shift || true
declared=("$@")
case $setup in
    ordinary|x11|wayland) ;;
    *)
        printf 'setup-linux: unknown setup %q\n' "$setup" >&2
        exit 64
        ;;
esac
[[ $setup == ordinary && ${#declared[@]} -eq 0 ]] && exit 0
[[ ${RUNNER_OS-} == Linux ]] || {
    printf 'setup-linux: %s setup requires a Linux runner\n' "$setup" >&2
    exit 64
}
: "${RUNNER_TEMP:?RUNNER_TEMP is required}"
: "${GITHUB_ENV:?GITHUB_ENV is required}"
packages=("${declared[@]}")
if [[ $setup != ordinary ]]; then
    packages+=(bubblewrap dbus-user-session libwayland-dev libxkbcommon0 mesa-vulkan-drivers)
    case $setup in
        x11) packages+=(i3-wm libxkbcommon-x11-0 x11-utils xauth xvfb) ;;
        wayland) packages+=(weston) ;;
    esac
fi
# A stalled mirror must fail the step quickly rather than consume the job's
# whole budget.
apt=(sudo apt-get -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=3)
# The runner image carries third-party repositories the substrate never
# draws on; a broken index there must not fail the refresh.
sudo rm -f /etc/apt/sources.list.d/google-chrome.list \
    /etc/apt/sources.list.d/google-chrome.sources \
    /etc/apt/sources.list.d/microsoft-prod.list \
    /etc/apt/sources.list.d/microsoft-prod.sources
# A mirror mid-sync answers with mismatched indexes for a minute or two;
# refresh again across that window before giving up.
for attempt in 1 2 3 4 5; do
    if "${apt[@]}" update; then
        break
    fi
    if (( attempt == 5 )); then
        printf 'setup-linux: package indexes never refreshed\n' >&2
        exit 1
    fi
    sleep 30
done
"${apt[@]}" install --no-install-recommends --yes "${packages[@]}"
[[ $setup == ordinary ]] && exit 0

if sysctl -N kernel.apparmor_restrict_unprivileged_userns >/dev/null 2>&1; then
    sudo sysctl --write kernel.apparmor_restrict_unprivileged_userns=0
fi
if sysctl -N kernel.unprivileged_userns_clone >/dev/null 2>&1; then
    sudo sysctl --write kernel.unprivileged_userns_clone=1
fi

sudo loginctl enable-linger "$USER"
sudo systemctl start "user@$(id -u).service"
runtime=/run/user/$(id -u)
for _ in {1..50}; do
    [[ -S $runtime/bus ]] && break
    sleep 0.1
done
[[ -S $runtime/bus ]] || {
    printf 'setup-linux: user D-Bus did not appear at %s/bus\n' "$runtime" >&2
    exit 1
}
printf 'XDG_RUNTIME_DIR=%s\n' "$runtime" >> "$GITHUB_ENV"
printf 'DBUS_SESSION_BUS_ADDRESS=unix:path=%s/bus\n' "$runtime" >> "$GITHUB_ENV"

lavapipe=$RUNNER_TEMP/eternalist-foundry-lavapipe
library=$(find /usr/lib -name libvulkan_lvp.so -print -quit)
manifest=$(find /usr/share/vulkan/icd.d -name 'lvp_icd*.json' -print -quit)
[[ -f $library ]] || {
    printf '%s\n' 'setup-linux: Lavapipe library is absent' >&2
    exit 1
}
[[ -f $manifest ]] || {
    printf '%s\n' 'setup-linux: Lavapipe manifest is absent' >&2
    exit 1
}
install -d "$lavapipe/usr/lib" "$lavapipe/usr/share/vulkan/icd.d"
ln -s "$library" "$lavapipe/usr/lib/libvulkan_lvp.so"
install -m 0644 "$manifest" "$lavapipe/usr/share/vulkan/icd.d/lvp_icd.json"
printf 'EGUI_TESTER_LAVAPIPE=%s\n' "$lavapipe" >> "$GITHUB_ENV"

case $setup in
    x11)
        command -v Xvfb >/dev/null
        command -v i3 >/dev/null
        ;;
    wayland)
        command -v weston >/dev/null
        command -v weston-screenshooter >/dev/null
        ;;
esac
