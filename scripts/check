#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

./check.py verify
scripts/check-cells
shellcheck \
    scripts/check \
    scripts/check-cells \
    scripts/test-vigil \
    scripts/verify-install \
    scripts/vigil \
    scripts/ci/*
scripts/test-vigil
actionlint \
    .github/workflows/ci.yml \
    .github/workflows/pipeline.yml \
    templates/ci.yml
cargo run --quiet --locked --bin foundry -- check
